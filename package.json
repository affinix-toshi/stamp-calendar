{
  "name": "stamp-calendar",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --project node --project app",
    "test:rules": "firebase emulators:exec --only database --project demo-stamp-calendar \"vitest run --project rules\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "deploy": "vite build && wrangler deploy",
    "rules:family": "firebase deploy --only database --project family --config firebase.json",
    "rules:demo": "firebase deploy --only database --project demo --config firebase.demo.json",
    "test:data": "firebase emulators:exec --only auth,database --project demo-stamp-calendar \"vitest run --project data\"",
    "migrate:backup": "tsx scripts/migrate/cli/backup.ts",
    "migrate:report": "tsx scripts/migrate/cli/report.ts",
    "migrate:run": "tsx scripts/migrate/cli/run.ts",
    "migrate:verify": "tsx scripts/migrate/cli/verify.ts"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
